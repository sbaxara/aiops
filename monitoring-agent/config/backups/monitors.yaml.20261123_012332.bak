monitors:
- assignee: support@example.com
  check_interval_seconds: 300
  config: {}
  consecutive_failures: 3
  enabled: true
  monitor_config_id: f77512d2-4af7-4222-9aba-821f0b16c45f
  name: CPU Monitor
  notification_channels: []
  severity: high
  subtype: null
  thresholds:
    cpu_percent:
      critical: 80
      warning: 70
  type: cpu
- assignee: support@example.com
  check_interval_seconds: 300
  config: {}
  consecutive_failures: 3
  enabled: true
  monitor_config_id: 98bc7efc-8320-4e24-9b84-f9aad76b9a5b
  name: Memory Monitor
  notification_channels: []
  severity: high
  subtype: null
  thresholds:
    memory_percent:
      critical: 90
      warning: 80
  type: memory
- assignee: support@example.com
  check_interval_seconds: 300
  config: {}
  consecutive_failures: 3
  enabled: true
  monitor_config_id: c05d1f4f-985b-4766-8cb2-da24d6b4ecb4
  name: Disk Monitor
  notification_channels: []
  severity: high
  subtype: null
  thresholds:
    disk_percent:
      critical: 90
      warning: 75
  type: disk
- assignee: support@example.com
  check_interval_seconds: 300
  config: {}
  consecutive_failures: 3
  enabled: true
  monitor_config_id: 827a783b-ead2-4e26-aeea-0d46f3ef144a
  name: Network Monitor
  notification_channels: []
  severity: medium
  subtype: null
  thresholds:
    max_drops: 1000
    max_errors: 1000
  type: network
- assignee: support@example.com
  check_interval_seconds: 60
  config:
    expected_body_contains: ''
    expected_status: 200
    method: GET
    timeout: 10
    url: ''
    verify_ssl: true
  consecutive_failures: 3
  enabled: false
  monitor_config_id: 4c19ab36-2ca5-4f99-9116-5870bc17fce8
  name: URL Monitor
  notification_channels: []
  severity: critical
  subtype: null
  thresholds:
    response_time_ms:
      critical: 3000
      warning: 1000
  type: url
- assignee: support@example.com
  check_interval_seconds: 120
  config:
    expected_min_count: 1
    match_cmdline: false
    process_name: ''
  consecutive_failures: 2
  enabled: false
  monitor_config_id: 389c101c-d6a9-4cc6-ad20-1a4ea3dd01b2
  name: Process Monitor
  notification_channels: []
  severity: critical
  subtype: null
  thresholds: {}
  type: process
- assignee: support@example.com
  check_interval_seconds: 60
  config:
    port: 0
    protocol: tcp
  consecutive_failures: 3
  enabled: false
  monitor_config_id: 6dbac14f-d7f9-4844-be34-71e156fbdf72
  name: Port Monitor
  notification_channels: []
  severity: critical
  subtype: null
  thresholds: {}
  type: port
- assignee: support@example.com
  check_interval_seconds: 300
  config:
    script_path: ''
    timeout: 120
  consecutive_failures: 2
  enabled: false
  monitor_config_id: e28d8550-1cad-43cb-acb2-3a5d9227392e
  name: Browser Monitor
  notification_channels: []
  severity: high
  subtype: null
  thresholds:
    duration_ms:
      critical: 10000
      warning: 5000
  type: browser
- assignee: support@example.com
  check_interval_seconds: 300
  config:
    include_context_lines: 5
    log_paths: []
    patterns:
    - level: ERROR
      name: exceptions
      regex: (exception|traceback|error)
      threshold: 0
    - level: WARN
      name: warnings
      regex: \bwarn(ing)?\b
      threshold: 10
    - level: CRITICAL
      name: out_of_memory
      regex: (out of memory|oom|killed)
      threshold: 0
  consecutive_failures: 3
  enabled: false
  monitor_config_id: ead637c2-0f65-433b-aebe-323d74e53563
  name: Log Monitor
  notification_channels: []
  severity: high
  subtype: null
  thresholds: {}
  type: log
- assignee: support@example.com
  check_interval_seconds: 60
  config:
    database: admin
    host: localhost
    password: ''
    port: 27017
    timeout_seconds: 10
    user: ''
  consecutive_failures: 3
  enabled: false
  monitor_config_id: 25ef097f-1235-436b-a0c6-661a182eaee9
  name: MongoDB Monitor
  notification_channels: []
  severity: critical
  subtype: mongodb
  thresholds:
    connection_time_ms:
      critical: 2000
      warning: 500
    replication_lag_ms:
      critical: 30000
      warning: 5000
  type: database
- assignee: support@example.com
  check_interval_seconds: 60
  config:
    database: mysql
    host: localhost
    password: ''
    port: 3306
    timeout_seconds: 10
    user: ''
  consecutive_failures: 3
  enabled: false
  monitor_config_id: 8bfba5bb-97c0-40a7-a23c-fe8f24df2507
  name: MySQL Monitor
  notification_channels: []
  severity: critical
  subtype: mysql
  thresholds:
    connection_time_ms:
      critical: 2000
      warning: 500
  type: database
- assignee: support@example.com
  check_interval_seconds: 60
  config:
    database: postgres
    host: localhost
    password: ''
    port: 5432
    timeout_seconds: 10
    user: ''
  consecutive_failures: 3
  enabled: false
  monitor_config_id: bb334020-5042-48c3-a614-9ee71dc0bd25
  name: PostgreSQL Monitor
  notification_channels: []
  severity: critical
  subtype: postgres
  thresholds:
    connection_time_ms:
      critical: 2000
      warning: 500
  type: database
- assignee: support@example.com
  check_interval_seconds: 86400
  config:
    timeout: 10
  consecutive_failures: 1
  enabled: true
  monitor_config_id: 58806ba1-bcf9-44dd-8768-35892a23be65
  name: SSL Certificate Monitor
  notification_channels: []
  severity: critical
  subtype: null
  thresholds:
    days_remaining:
      critical: 7
      warning: 30
  type: ssl
