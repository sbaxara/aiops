# ---------------------------------------------------------------------------
# Axara AIOps — monitoring-server environment. Copied to .env on a fresh install
# by ensure_env.py, which replaces the two placeholders below with strong
# random values. Everything else is optional; keep secrets out of git.
# ---------------------------------------------------------------------------
SECRET_KEY=your-secret-key-min-32-chars
MASTER_ENCRYPTION_KEY=your-master-encryption-key-32-chars

# DB_USER=monitoring
# DB_PASSWORD is generated by ensure_env.py on a fresh install (required).
# LLM_MODEL=gemma4:26b
# OLLAMA_URL=http://ollama:11434      # when set, shown read-only in Settings
# CHROMA_URL=http://chromadb:8000     # when set, shown read-only in Settings
# ALLOWED_ORIGINS=https://monitoring.example.com
# ALLOWED_API_ORIGINS='self' https://monitoring.example.com:9090   # CSP connect-src for API pages (default 'self')
# TRUSTED_PROXIES=172.16.0.0/12          # proxies whose X-Real-IP is trusted (audit IPs)

# --- Jira (ticketing; leave empty to run without tickets) ---
# JIRA_URL=https://yourcompany.atlassian.net
# JIRA_USER=automation@yourcompany.com
# JIRA_API_KEY=
# JIRA_PROJECT_KEY=OPS
# --- Optional services ---
# COMPOSE_PROFILES=webui                 # dev only: start Open WebUI (no auth) on :3000

# --- API documentation ---
# API_DOCS_ENABLED=1                    # serve /docs and /openapi.json (off by default in production)
