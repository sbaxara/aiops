# Secrets Configuration (DO NOT commit to version control)
# Copy to secrets.yaml and fill in your values

jira:
  url: "https://your-company.atlassian.net"
  user: "monitoring@company.com"
  api_key: "your-jira-api-key"
  project_key: "OPS"

servicenow:
  url: "https://your-company.service-now.com"
  user: "monitoring_integration"
  password: "your-servicenow-password"

teams:
  webhook: "https://outlook.office.com/webhook/your-webhook-url"

slack:
  bot_token: "xoxb-your-slack-bot-token"
  channel: "#monitoring-alerts"

security:
  secret_key: "your-jwt-secret-key-min-32-chars"
  master_encryption_key: "your-master-encryption-key-32-chars"
