# Build environment for the Linux agent (build time only; customers never need Docker).
# manylinux2014 = CentOS 7 userland, glibc 2.17: the compiled agent runs on RHEL/CentOS 7+,
# Ubuntu 18.04+ and Debian 9+. The image ships CPython builds in /opt/python, gcc and patchelf.
FROM quay.io/pypa/manylinux2014_x86_64
# manylinux Pythons have no shared libpython; Nuitka standalone links the static library,
# which the image ships packed (static-libs-for-embedding-only.tar.xz) and must be unpacked.
RUN cd /opt/_internal && tar xf static-libs-for-embedding-only.tar.xz \
 && ln -sf /opt/python/cp312-cp312/bin/python3.12 /usr/local/bin/python3.12 \
 && python3.12 -m pip --version
WORKDIR /work
